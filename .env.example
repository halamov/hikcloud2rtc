# Логин Hik-Connect (облако)
HIK_USER=you@example.com
HIK_PASSWORD=changeme

# Тег образа: 0.<ГГ><ММ><ДД>.<ЧЧ> — дата/время сборки (обязательно, без latest).
# Сгенерируйте в момент сборки и пропишите сюда:
#   HIK_TAG=0.$(date +%y%m%d.%H)     # → напр. 0.261018.15
HIK_TAG=0.261018.15

# PacedWriter: сглаживание кадровых bursts облака (GOP приходит за раз,
# затем пауза ~2 с).
#   1 (по умолчанию) — кадры выдаются ровным потоком: плавная картинка
#                     (глубина буфера ~1 с)
#   0                — кадры уходят сразу при получении: минимальная
#                     задержка, но при GOP-передачах будут 2-с застытия
#                     и «перемотка»
PACE_FRAMES=1

# Режим воркеров:
#   always (по умолчанию) — воркеры живут 24/7: поток тёплый, любой /frame
#     сразу, НО трафик с облака идёт постоянно (~18 ГБ/день на main-камеру,
#     ~1.2 ГБ/день на sub). Подходит, когда камеры смотрят часто.
#   idle — воркер убивается через WORKER_IDLE_TIMEOUT секунд без клиентов:
#     трафик только вокруг опросов. Сценарий «звонок в домофон → /frame»:
#     триггер звонка разбуживает воркер GET /prime?channel=N, /frame
#     отвечает за ~4 с (теплый GOP), через WORKER_IDLE_TIMEOUT тишины
#     воркер и VTM-сессия закрываются.
WORKER_MODE=always

# Сколько секунд без клиентов держать воркер (только в режиме idle).
# 90 — комфортно для «звонка в домофон»: если после /prime сразу идёт
# /frame и распознание, воркер не закроется в середине.
WORKER_IDLE_TIMEOUT=90
